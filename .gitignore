/target
**/*.rs.bk
Cargo.lock.bak

# IDE
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# Per-user LLM provider configs — may contain API keys.
/sica-settings/
idealist_workspace/
sessions/*.*

# Oversized tool outputs the sub-agent spilled to disk (see agents::spill).
spill/

# Long-term memory (agents::long_term) — personal facts the agent learned.
memories/

# model-eval reports — regenerated on every run.
evals/reports/
